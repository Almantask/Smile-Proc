<?xml version="1.0" encoding="utf-8"?>
<!-- M1 spike app (docs/spikes.md). Throwaway, never shipped: it uses a location foreground
     service, which the product app may only use if the human approves spike A2. No INTERNET. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- A2b only -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_face"
        android:label="@string/app_name"
        android:theme="@style/Theme.Spikes">

        <activity
            android:name=".SpikeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Face buttons, restore alarm, delete intent (android.md › Saving from a notification tap). -->
        <receiver
            android:name=".FaceReceiver"
            android:exported="false" />

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- adb control for the emulator runs (scripts/emu/spikes.sh). Exported but guarded by DUMP,
             which only the adb shell holds, like the debug receivers in app/src/debug. -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.smileproc.spikes.POST" />
                <action android:name="com.example.smileproc.spikes.CANCEL" />
                <action android:name="com.example.smileproc.spikes.SET" />
                <action android:name="com.example.smileproc.spikes.SCHEDULE_REMINDER" />
                <action android:name="com.example.smileproc.spikes.CLEAR" />
                <action android:name="com.example.smileproc.spikes.PROBE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".LocationFgs"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
