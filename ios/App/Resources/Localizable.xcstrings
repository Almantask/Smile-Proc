    "debug.spikeNotes": {
      "comment": "DO NOT EDIT. Generated by spec/tools/gen_strings.py from spec/strings/en.json.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A1: after the phone has been unlocked once since boot, lock it and tap a reminder face. The check-in is in History after you unlock, and the lock screen only says SmileProc. A2: a reminder saves the last known location, or none. A3: the home-screen widget shows Saved for about 60 seconds and does not show which face. A4: leave a reminder overnight and note how many minutes late it was."
          }
        }
      }
    },
