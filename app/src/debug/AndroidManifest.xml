<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (plan B.11). Exported so adb can reach them, but guarded by DUMP,
     which the adb shell holds and ordinary apps can't get. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".debug.DesignPrototypeActivity"
            android:exported="true"
            android:theme="@style/Theme.SmileProc"
            tools:ignore="ExportedActivity" />
        <receiver
            android:name=".debug.ProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.smileproc.debug.PROBE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DebugEventsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.smileproc.debug.FIRE_REMINDER" />
                <action android:name="com.example.smileproc.debug.FIRE_RESTORE" />
                <action android:name="com.example.smileproc.debug.SEED_DEMO" />
                <action android:name="com.example.smileproc.debug.CLEAR_DEMO" />
                <action android:name="com.example.smileproc.debug.SEAL_TEST_ENTRY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
