    <!-- Privacy screen -->
    <string name="privacy_title">What\'s stored and where</string>
    <string name="privacy_stays">Check-ins, place names and settings stay on this phone. SmileProc has no account and no server, and it doesn\'t send anything anywhere.</string>
    <string name="privacy_leaves">Something leaves the phone only if you export a file, or if you tap a support contact and your phone opens the call, text or browser.</string>
    <string name="privacy_backups">History is not in phone backups or phone-to-phone transfer. A lost phone means lost history, unless you exported a copy.</string>
    <string name="privacy_location">If you allow it, a check-in can include where you were. You can turn that off, or remove location from every check-in.</string>

