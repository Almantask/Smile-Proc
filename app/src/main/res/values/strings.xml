    <string name="privacy_on_phone">Your check-ins, feelings, notes and places are stored only on this phone, encrypted.</string>
    <string name="privacy_nothing_leaves">Nothing leaves the phone unless you export a file or tap a support contact.</string>
    <string name="privacy_no_backup">Your history isn\'t included in backups or phone-to-phone transfers.</string>
    <string name="privacy_lost_phone">If this phone is lost, your history goes with it unless you\'ve exported a copy.</string>
    <string name="privacy_no_account">There\'s no account, no analytics and no ads.</string>

